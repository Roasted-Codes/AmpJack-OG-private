@@ -898,6 +905,15 @@
         trace_usb_ohci_td_skip_async();
         return 1;
     }
+    if (!completion && ohci->async_td) {
+        /*
+         * Only one packet is active per controller, not per endpoint.
+         * Its shared buffer remains owned until the TD is retired, even
+         * after asynchronous completion.  Do not overwrite it below.
+         */
+        trace_usb_ohci_td_too_many_pending(OHCI_BM(ed->flags, ED_EN));
+        return 1;
+    }
     if (ohci_read_td(ohci, addr, &td)) {
         trace_usb_ohci_td_read_error(addr);
         ohci_die(ohci);
@@ -983,16 +999,6 @@
             return 1;
         }
