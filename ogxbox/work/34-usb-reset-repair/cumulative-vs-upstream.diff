+        if (usb_packet_is_inflight(&ohci->usb_packet)) {
+            usb_cancel_packet(&ohci->usb_packet);
+        }
         ohci->async_td = 0;
+        ohci->async_complete = false;
     }
     for (i = 0; i < ohci->num_ports; i++) {
