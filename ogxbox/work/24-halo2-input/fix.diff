diff --git a/ogxbox/integration/build_pic.sh b/ogxbox/integration/build_pic.sh
new file mode 100644
index 0000000..cebbbd6
--- /dev/null
+++ b/ogxbox/integration/build_pic.sh
@@ -0,0 +1,61 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-3.0-or-later
+# i386 static-PIE build of the TITLE-RESIDENT module: the proven GIP USB transport
+# (gipdrive.h, header-only, address-independent) + the hardened virtual-XInput
+# presentation + the six hook stubs + chain trampolines + build-bound installer +
+# FindClassDriver class-match hook. Proves the whole vertical slice is PIC: only
+# R_386_RELATIVE relocation is permitted (readelf -r), no text relocations
+# (-z text), and the chain trampolines hold no stale displaced PC-relative offset.
+#
+# The GIP core/adapter PIC-ness was already proven by ogxbox/loader (worker 05);
+# this build is the loadable module the parent injector stages + relocates.
+set -euo pipefail
+cd "$(dirname "$0")"
+mkdir -p out
+
+CLANG=${CLANG:-clang}
+LLD=${LLD:-ld.lld}
+
+CFLAGS="-target i386-unknown-none-elf -march=pentium3 -Os -std=gnu11 \
+ -ffreestanding -nostdlib -fpie -fvisibility=hidden \
+ -mstack-alignment=4 -fno-stack-protector -fno-asynchronous-unwind-tables \
+ -fno-unwind-tables -fno-exceptions -fno-common -ffunction-sections -fdata-sections \
+ -Wall -Wextra -Wno-unused-parameter -Wno-unused-function"
+
+LDFLAGS="-pie --no-dynamic-linker -z text -z norelro --hash-style=sysv --gc-sections -T link.ld"
+
+INC="-I. -Ifreestanding -I.. -I../gip -I../halo2 -I../../core -I../gipdriver/src"
+
+$CLANG $CFLAGS $INC -c crt0.c          -o out/crt0.o
+$CLANG $CFLAGS $INC -c string.c        -o out/string.o
+$CLANG $CFLAGS $INC -c ogx_present.c   -o out/ogx_present.o
+$CLANG $CFLAGS $INC -c ogx_stub.c      -o out/ogx_stub.o
+$CLANG $CFLAGS $INC -c ../halo2/xinput_model.c -o out/xinput_model.o
+$CLANG $CFLAGS $INC -c ogx_transport.c -o out/ogx_transport.o
+$CLANG $CFLAGS $INC -c ogx_install.c   -o out/ogx_install.o
+$CLANG $CFLAGS $INC -c module_main.c   -o out/module_main.o
+$CLANG $CFLAGS $INC -c trampoline.S    -o out/trampoline.o
+
+$LLD $LDFLAGS -Map out/pic.map -o out/pic.elf \
+    out/crt0.o out/string.o out/ogx_present.o out/ogx_stub.o \
+    out/xinput_model.o out/ogx_transport.o out/ogx_install.o \
+    out/module_main.o out/trampoline.o
+
+echo "== relocation audit: only R_386_RELATIVE allowed, no TEXTREL =="
+readelf -r out/pic.elf
+readelf -d out/pic.elf | grep -i textrel && { echo "FAIL: TEXTREL present"; exit 1; } || echo "ok: no TEXTREL flag"
+
+echo "== text/data/bss sizes (from size on the linked ELF) =="
+size out/pic.elf
+
+echo "== section sizes from the linker map =="
+grep -E '^\\.(text|rodata|data|bss|data\\.hooktab)' out/pic.map | head -20 || true
+
+echo "== chain trampoline bytes: XInputClose re-encoded (no stale E8 rel32) =="
+objdump -d -Mintel out/trampoline.o | grep -A8 'ogx_chain_inputclose' || true
+echo "== confirm no stale call-rel32 (e8 <target>) remains in any chain stub =="
+if objdump -d out/trampoline.o | grep -qE 'call +[0-9]'; then
+    echo "FAIL: a relative call remains"; exit 1
+else
+    echo "ok: no relative call retained (all absolute-constant + register-indirect)"
+fi
diff --git a/ogxbox/integration/module_main.c b/ogxbox/integration/module_main.c
new file mode 100644
index 0000000..5872100
--- /dev/null
+++ b/ogxbox/integration/module_main.c
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/*
+ * module_main.c -- the REAL title-resident module entry (replaces the disabled
+ * diagnostic). It wires the proven GIP USB transport (ogx_transport.c +
+ * gipdrive.h) into the existing hardened virtual-XInput presentation
+ * (ogx_present.c), then installs the six XInput E9 detours plus the
+ * FindClassDriver class-match detour (ogx_install.c, build-bound + revertible).
+ *
+ * It does NOT boot, log, draw, or launch anything: ogx_module_entry() runs once
+ * at title entry (before XInitDevices), and ogx_module_pump() is the per-tick
+ * transport pump the loader borrows from a title loop hook. attached_mask starts
+ * 0 and is raised ONLY when a real USB attach opens the interrupt IN endpoint.
+ */
+#include "ogx_module.h"
+
+int ogx_module_main(void)
+{
+	int rc;
+
+	/* wire the presentation ctx + transport seams + GIP class description.
+	 * host pointers (ogx_g_module.host) were injected by the loader first. */
+	ogx_transport_init();
+
+	/* install the class-match detour + six XInput detours, build-bound.
+	 * Refuses (rolls back) on wrong original bytes / missing required surface. */
+	rc = ogx_install_hooks();
+
+	/* rc < 0 => fail-closed: no gamepad, stock classes untouched. rc == 0 =>
+	 * hooks armed; a hotplug (pad present, or plugged after install) enumerates
+	 * through our className driver and the six hooks serve virtual XInput. */
+	return rc;
+}
diff --git a/ogxbox/integration/ogx_install.c b/ogxbox/integration/ogx_install.c
new file mode 100644
index 0000000..f554796
--- /dev/null
+++ b/ogxbox/integration/ogx_install.c
@@ -0,0 +1,118 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/*
+ * ogx_install.c -- build-bound, revertible E9 detour installer for the title.
+ *
+ * Installs the six XInput hooks (og_hook_sites.h) -> the six ogx_stub_x* entry
+ * points, plus the FindClassDriver class-match hook @0x41517D -> ogx_findclassdriver.
+ * Every site is guarded by the EXACT original 5 bytes it will overwrite
+ * (VERIFIED against the frozen XBE by detour_plan.py + pin_u803.py); the site is
+ * verified BEFORE the write, the E9 target is computed from the relocated module
+ * symbol addresses (actual patch bytes/math, no text search), the write is
+ * verified AFTER, and any partial failure restores the already-applied sites from
+ * the saved original bytes (rollback). It is NOT presented as a 5-byte-atomic
+ * patch: it is safe only because it runs at title entry, before XInitDevices
+ * enumerates, on a single CPU/thread (see ogx_module.h).
+ */
+#include "ogx_module.h"
+#include "../halo2/og_hook_sites.h"
+
+/* the six hook entry points (ogx_stub.c) */
+extern uint32_t  OGX_STDCALL ogx_stub_xgetdevicechanges(uintptr_t, uint32_t *, uint32_t *);
+extern uintptr_t OGX_STDCALL ogx_stub_xinputopen(uintptr_t, uint32_t, uint32_t, uintptr_t);
+extern void      OGX_STDCALL ogx_stub_xinputclose(uintptr_t);
+extern uint32_t  OGX_STDCALL ogx_stub_xinputgetcaps(uintptr_t, uintptr_t);
+extern uint32_t  OGX_STDCALL ogx_stub_xinputgetstate(uintptr_t, uintptr_t);
+extern uint32_t  OGX_STDCALL ogx_stub_xinputsetstate(uintptr_t, uintptr_t);
+
+/* the six hook entry point addresses in OGX_HOOK_SITES order */
+static const uintptr_t g_xinput_hooks[OGX_HOOK_SITE_COUNT] = {
+	(uintptr_t)&ogx_stub_xgetdevicechanges,
+	(uintptr_t)&ogx_stub_xinputopen,
+	(uintptr_t)&ogx_stub_xinputclose,
+	(uintptr_t)&ogx_stub_xinputgetcaps,
+	(uintptr_t)&ogx_stub_xinputgetstate,
+	(uintptr_t)&ogx_stub_xinputsetstate,
+};
+
+/* u803 USBD_FindClassDriver detour site (VERIFIED: pin_u803.py) */
+#define OGX_FC_VA 0x0041517Du
+static const uint8_t OGX_FC_ORIG5[5] = { 0x56, 0xB8, 0xB4, 0x27, 0x41 };
+
+/* ---- one 5-byte E9 site: verify -> write -> verify; 0 ok, <0 refused -------- */
+static int ogx_patch_site(uint32_t va, const uint8_t *orig5, uintptr_t target)
+{
+	uint8_t patch[5];
+	int32_t rel;
+	int i;
+
+	for (i = 0; i < 5; i++)
+		if (*((volatile uint8_t *)(va + i)) != orig5[i])
+			return -1;                       /* wrong build / already patched */
+
+	patch[0] = 0xE9;
+	rel = (int32_t)(target - (va + 5));
+	patch[1] = (uint8_t)( rel        & 0xFF);
+	patch[2] = (uint8_t)((rel >>  8) & 0xFF);
+	patch[3] = (uint8_t)((rel >> 16) & 0xFF);
+	patch[4] = (uint8_t)((rel >> 24) & 0xFF);
+
+	for (i = 0; i < 5; i++)
+		*((volatile uint8_t *)(va + i)) = patch[i];
+	for (i = 0; i < 5; i++)
+		if (*((volatile uint8_t *)(va + i)) != patch[i])
+			return -2;                       /* write did not stick */
+	return 0;
+}
+
+/* restore a site to its original 5 bytes (rollback) */
+static void ogx_restore_site(uint32_t va, const uint8_t *orig5)
+{
+	int i;
+	for (i = 0; i < 5; i++)
+		*((volatile uint8_t *)(va + i)) = orig5[i];
+}
+
+/* ------------------------------------------------------------------------- */
+/* install: returns 0 on success; non-zero fail-closed (partial rollback)    */
+/* ------------------------------------------------------------------------- */
+int ogx_install_hooks(void)
+{
+	int rc;
+	int i;
+
+	/* required injected surface BEFORE any write: without a submit pointer the
+	 * GIP device could be claimed but never driven -> refuse to arm */
+	if (!ogx_g_module.host.submit_request ||
+	    !ogx_g_module.host.class_table_begin ||
+	    !ogx_g_module.host.class_table_end) {
+		ogx_g_module.install_failed = 1;
+		return -1;
+	}
+
+	/* 1. FindClassDriver class-match detour */
+	rc = ogx_patch_site(OGX_FC_VA, OGX_FC_ORIG5, (uintptr_t)&ogx_findclassdriver);
+	if (rc != 0) {
+		ogx_g_module.install_failed = 1;
+		return rc;
+	}
+	ogx_g_module.installed_hooks |= (1u << 7);
+
+	/* 2. the six XInput hooks */
+	for (i = 0; i < (int)OGX_HOOK_SITE_COUNT; i++) {
+		uint32_t va = OGX_HOOK_SITES[i].va;
+		rc = ogx_patch_site(va, OGX_HOOK_SITES[i].orig5, g_xinput_hooks[i]);
+		if (rc != 0) {
+			/* rollback the sites we already applied (incl. the FC detour) */
+			int j;
+			for (j = 0; j < i; j++)
+				ogx_restore_site(OGX_HOOK_SITES[j].va, OGX_HOOK_SITES[j].orig5);
+			ogx_restore_site(OGX_FC_VA, OGX_FC_ORIG5);
+			ogx_g_module.installed_hooks = 0;
+			ogx_g_module.install_failed = 1;
+			return rc;
+		}
+		ogx_g_module.installed_hooks |= (1u << i);
+	}
+
+	return 0;
+}
diff --git a/ogxbox/integration/ogx_module.h b/ogxbox/integration/ogx_module.h
new file mode 100644
index 0000000..654132d
--- /dev/null
+++ b/ogxbox/integration/ogx_module.h
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/*
+ * ogx_module.h -- title-resident AmpJack-OG module ABI.
+ *
+ * The vertical slice: the PROVEN GIP USB transport (ogxbox/gipdriver/gipdrive.h,
+ * header-only, address-independent) feeds the existing hardened virtual-XInput
+ * presentation (ogx_present.{h,c}) through exactly ONE injected set of title
+ * function pointers. No D3D, no XLaunchNewImage, no global XInput/guide code, and
+ * NO 0x30000-method addresses from the standalone probe are carried into the
+ * title: every title call goes through a VERIFIED u803 VA injected here.
+ *
+ * Load model: the parent trainer/injector relocates this static-PIE image
+ * (R_386_RELATIVE only), fills `struct ogx_mod_host` with the VERIFIED u803 VAs,
+ * calls ogx_module_entry() ONCE at title entry (BEFORE XInitDevices enumerates,
+ * so install is single-threaded), then calls ogx_module_pump() every title tick
+ * from a borrowed loop hook. Install is NOT claimed to be a thread-safe 5-byte
+ * atomic patch; its safety comes from running before enumeration on one thread.
+ */
+#ifndef OGX_MODULE_H
+#define OGX_MODULE_H
+
+#include <stdint.h>
+#include "ogx_present.h"
+#include "../gipdriver/src/gipdrive.h"
+
+/* ---- the fixed virtual slot the modern GIP pad is published on -------------- */
+/*
+ * FIXED SLOT = port index 1 ("front port 2"). The owner keeps a stock pad on
+ * port 1 (index 0); the modern pad is assumed on port 2 (index 1). This is a
+ * DOCUMENTED FIXED SLOT, NOT a native-derived physical port: the real
+ * port-number -> front-port wiring for a non-hub GIP device is UNKNOWN on this
+ * box (binding REPORT §6), so no derivation is faked. ogx_present's
+ * native_connected_mask guard still suppresses the virtual device on any port a
+ * NATIVE gamepad already owns, so a stock pad can never be "stolen" — the fixed
+ * slot is only ever visible when port 1 is not natively occupied.
+ */
+#define OGX_TRANSPORT_PORT 1u
+
+/* ---- the title function pointers the injector MUST fill --------------------- */
+/*
+ * VERIFIED (canonical research + pin_u803.py byte read of the frozen XBE):
+ *   submit_request      = IUsbDevice::SubmitRequest @ 0x004155BF (__thiscall)
+ *   findclassdriver     = USBD_FindClassDriver   @ 0x0041517D (__stdcall,1)
+ *   class_table_begin/end = 0x004127B4 / 0x004127CC  (writable XPP)
+ * NOT VERIFIED (fail-closed NULL => attach still streams input, but the module
+ *   will NOT signal AddComplete / run the native remove-close chain):
+ *   add_complete        = IUsbDevice::AddComplete    @ UNKNOWN (__thiscall,void)
+ *   cancel_request      = IUsbDevice::CancelRequest  @ UNKNOWN (__thiscall,long)
+ *   remove_complete     = IUsbDevice::RemoveComplete @ UNKNOWN (__thiscall,void)
+ *
+ * The module refuses to arm (ogx_module_entry returns non-zero, installs nothing)
+ * unless submit_request, findclassdriver, class_table_begin and class_table_end
+ * are non-zero AND the xdevice_type_gamepad value is set. A missing
+ * add_complete/cancel/remove is a SAFE degradation (input still flows; the
+ * unplug close-chain and enumeration-completion signalling are skipped), never a
+ * crash, and is reported in ogx_module_status() so the parent can see it.
+ */
+struct ogx_mod_host {
+	uint32_t submit_request;      /* 0x4155BF  __thiscall(self=ecx, urb) -> long */
+	uint32_t findclassdriver;     /* 0x41517D  __stdcall(classId) -> desc*        */
+	uint32_t add_complete;        /* UNKNOWN   __thiscall(self, status)          */
+	uint32_t cancel_request;      /* UNKNOWN   __thiscall(self, urb) -> long     */
+	uint32_t remove_complete;     /* UNKNOWN   __thiscall(self)                  */
+	uint32_t class_table_begin;   /* 0x4127B4                                  */
+	uint32_t class_table_end;     /* 0x4127CC                                  */
+
+	/* the value Halo passes for XDEVICE_TYPE_GAMEPAD when it calls
+	 * XGetDeviceChanges/XInputOpen. NOT auto-derived: the XPP word at
+	 * 0x4127D8 reads 0x00000000 in the frozen image (runtime-populated), so the
+	 * exact gamepad device-type value is INFERENCE-only and must be measured by
+	 * the parent's first live check before the virtual device is trusted. With
+	 * 0 the dtype check in ogx_XGetDeviceChanges never matches, so the virtual
+	 * device is silently not published (fail-closed) rather than guessed. */
+	uint32_t xdevice_type_gamepad;
+
+	/* injected clock (ms). NULL => 0 (the GIP state machine is completion-driven
+	 * and does not need wall time; this is only for future rumble pacing). */
+	uint64_t (*now_ms)(void);
+};
+
+/* ---- one title-resident module instance (all static, no heap) --------------- */
+struct ogx_module {
+	struct ogx_mod_host     host;                      /* injected pointers      */
+	struct ogx_host_ctx     present;                   /* ogx_present services   */
+	struct og_gip_port      gport[OGX_MAX_PORTS];      /* snapshots the module  */
+	struct gdr_gip          gip;                       /* GIP decoder + tx queue */
+	struct gdr_ring         ring;                      /* DPC -> main-loop ring  */
+	struct gdr_attach_ctx   att;                       /* S0..S5 + lifecycle     */
+	struct gdr_class_desc   desc;                      /* 24-byte GIP description */
+	volatile uint32_t       attached;                  /* transport live guard    */
+	uint32_t                installed_hooks;           /* bitmask of E9s applied  */
+	uint32_t                install_failed;            /* fail-closed latch       */
+};
+
+extern struct ogx_module ogx_g_module;
+
+/* entry + pump + hook entry points -------------------------------- */
+void ogx_transport_init(void);                          /* wire ctx/seams/desc   */
+int  ogx_install_hooks(void);                           /* 6 XInput + FC E9 write */
+int  ogx_module_entry(void *unused);                    /* .text.entry           */
+void ogx_module_pump(void);                             /* per-title-tick        */
+uintptr_t OGX_STDCALL ogx_findclassdriver(uint32_t classId); /* E9 hook target */
+uint32_t ogx_module_status(void);                       /* install/transport bitmask */
+
+#endif /* OGX_MODULE_H */
diff --git a/ogxbox/integration/ogx_transport.c b/ogxbox/integration/ogx_transport.c
new file mode 100644
index 0000000..0ed23c9
--- /dev/null
+++ b/ogxbox/integration/ogx_transport.c
@@ -0,0 +1,240 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/*
+ * ogx_transport.c -- the PROVEN GIP USB transport, retargeted to the Halo 2 u803
+ * title. It is the thin platform wrapper over ogxbox/gipdriver/gipdrive.h: it
+ * does NOT duplicate the USB stack or rewrite the GIP protocol. It only supplies
+ * the injected title call surface (SubmitRequest / AddComplete / CancelRequest /
+ * RemoveComplete, all VERIFIED/UNKNOWN VAs from ogx_module.h) and the
+ * FindClassDriver class-match hook, then bridges the decoded gdr_snapshot into
+ * the og_gip_port snapshot that ogx_present.c serves.
+ *
+ * DPC contract (unchanged from the proven probe): every completion callback only
+ * pushes one bounded ring event and re-submits; no file I/O, no malloc, no
+ * unbounded formatting and no parse happens in the DPC. All decoding, snapshot
+ * publication and OUT queuing happen here in ogx_module_pump(), on the title
+ * thread, which is the single owner. No waiting on the title thread, no timers
+ * and no blocking in the XInput hook.
+ */
+#include "ogx_module.h"
+
+/* ---- chain trampolines (trampoline.S) + the stub ctx binder (ogx_stub.c) ---- */
+void   ogx_stub_bind_ctx(struct ogx_host_ctx *ctx);
+/* The trampolines are tail-jump stubs that re-run the displaced bytes and jmp to
+ * the original body; the original body does the final `ret N`. Declare them with
+ * the title's stdcall signature so ogx_present.c calls them with the right arg
+ * count (their asm body reads the args from the stack and never returns). */
+uint32_t  OGX_STDCALL ogx_chain_getdevicechanges(uintptr_t, uint32_t *, uint32_t *);
+uintptr_t OGX_STDCALL ogx_chain_inputopen(uintptr_t, uint32_t, uint32_t, uintptr_t);
+void      OGX_STDCALL ogx_chain_inputclose(uintptr_t);
+uint32_t  OGX_STDCALL ogx_chain_getcaps(uintptr_t, uintptr_t);
+uint32_t  OGX_STDCALL ogx_chain_getstate(uintptr_t, uintptr_t);
+uint32_t  OGX_STDCALL ogx_chain_setstate(uintptr_t, uintptr_t);
+
+/* -- thiscall thunks: C cannot put `self` in ECX portably, so the injected VAs
+ *    are cast to __attribute__((thiscall)) function pointers (i386 clang). ---- */
+typedef long (__attribute__((thiscall)) *ogx_thiscall_submit)(void *self, void *urb);
+typedef void (__attribute__((thiscall)) *ogx_thiscall_addcomplete)(void *self, long status);
+typedef long (__attribute__((thiscall)) *ogx_thiscall_cancel)(void *self, void *urb);
+typedef void (__attribute__((thiscall)) *ogx_thiscall_removecomplete)(void *self);
+
+/* ---- module singleton (declared extern in ogx_module.h). The injector fills
+ *      ogx_g_module.host BEFORE ogx_module_entry(): BSS is zero at load, and
+ *      entry does NOT re-zero host. ---------------------------------------------- */
+struct ogx_module ogx_g_module;
+
+/* ---- transport seams: gdr_*_fn are plain function pointers in gipdrive.h;
+ *      these wrappers do the thiscall through the injected VA. ------------------ */
+static long ogx_usb_submit(void *device, void *urb)
+{
+	if (!ogx_g_module.host.submit_request)
+		return -1;
+	return ((ogx_thiscall_submit)(uintptr_t)ogx_g_module.host.submit_request)(device, urb);
+}
+static void ogx_usb_add_complete(void *device, long status)
+{
+	if (ogx_g_module.host.add_complete)
+		((ogx_thiscall_addcomplete)(uintptr_t)ogx_g_module.host.add_complete)(device, status);
+}
+static long ogx_usb_cancel(void *device, void *urb)
+{
+	if (!ogx_g_module.host.cancel_request)
+		return -1;
+	return ((ogx_thiscall_cancel)(uintptr_t)ogx_g_module.host.cancel_request)(device, urb);
+}
+static void ogx_usb_remove_complete(void *device)
+{
+	if (ogx_g_module.host.remove_complete)
+		((ogx_thiscall_removecomplete)(uintptr_t)ogx_g_module.host.remove_complete)(device);
+}
+
+/* ---- GIP class-driver description + callbacks ------------------------------ */
+
+static void OGX_STDCALL ogx_gip_register(void *iUsbInit) { (void)iUsbInit; }
+static void OGX_STDCALL ogx_gip_attach(void *device);
+static void OGX_STDCALL ogx_gip_remove(void *device);
+
+/* ---- FindClassDriver E9 hook target ---------------------------------------- */
+/*
+ * u803 FindClassDriver @0x41517D VERIFIED (pin_u803.py, frozen bytes
+ * 56 B8 B4 27 41 00 BE CC 27 41 00 3B C6 8B C8 73 ...):
+ *     for (p = begin; p < end; p += 4) { if (!(d=*p)) continue;
+ *         if (Lo(classId)==d->MatchByte0 && Hi(classId)==d->MatchByte1) return d; }
+ *     return 0;
+ * Reimplement that exact loop (pure C, IRQL-safe, no nested call) so every stock
+ * class returns the identical descriptor; only 0xFF81 (GIP, measured on the real
+ * device) returns ours. begin/end are INJECTED so a mismatched build fails closed.
+ */
+uintptr_t OGX_STDCALL ogx_findclassdriver(uint32_t classId)
+{
+	uint32_t begin = ogx_g_module.host.class_table_begin;
+	uint32_t end   = ogx_g_module.host.class_table_end;
+	uint32_t addr;
+
+	if ((classId & 0xffffu) == (uint32_t)GDR_PNP_GIP)
+		return (uintptr_t)&ogx_g_module.desc;
+
+	for (addr = begin; addr + 4 <= end; addr += 4) {
+		uintptr_t d = *(volatile uint32_t *)addr;
+		if (!d)
+			continue;
+		if ((uint8_t)classId == *(volatile uint8_t *)d &&
+		    (uint8_t)(classId >> 8) == *((volatile uint8_t *)d + 1))
+			return d;
+	}
+	return 0;
+}
+
+/* attach-ran flag (separate from the derived "transport live" state) */
+static volatile uint32_t ogx_attach_ran;
+
+static void OGX_STDCALL ogx_gip_attach(void *device)
+{
+	ogx_attach_ran = 1;
+	ogx_g_module.att.in_complete = gdr_in_complete;  /* shared completion (gipdrive.h) */
+	ogx_g_module.att.cb_log = 0;                     /* no per-completion CB events    */
+	if (gdr_attach_begin(&ogx_g_module.att, device, ogx_usb_submit, &ogx_g_module.ring)) {
+		/* refused: previous generation still quiescing -> fail closed, abort THIS
+		 * enumeration instead of clobbering a live context. */
+		ogx_g_module.att.add_complete(device, (long)(int)0xC0000001L);
+	}
+}
+static void OGX_STDCALL ogx_gip_remove(void *device)
+{
+	gdr_remove_device(&ogx_g_module.att, device);
+}
+
+/* ---- snapshot -> presentation bridge ----------------------------------------
+ * gdr_snapshot and og_gamepad share the SAME 18-byte wire layout (asserted).    */
+static void ogx_bridge_publish(void)
+{
+	struct ogx_host_ctx *p = &ogx_g_module.present;
+	struct og_gip_port *gp = &ogx_g_module.gport[OGX_TRANSPORT_PORT];
+	uint32_t mask = 1u << OGX_TRANSPORT_PORT;
+	int live = gdr_transport_live((int)ogx_attach_ran, ogx_g_module.att.in_handle);
+
+	if (live) {
+		/* powered-readable = gdr_gip.ready (set once minimal power-on accepted).
+		 * Same "powered-ready, NOT input-seen" contract og_gip.h documents. */
+		gp->ready = ogx_g_module.gip.ready ? true : false;
+		if (ogx_g_module.gip.snapshot_valid) {
+			gp->snapshot_valid = true;
+			memcpy(&gp->gamepad, &ogx_g_module.gip.snap, sizeof(gp->gamepad));
+			gp->seq = ogx_g_module.gip.input_reports;
+		}
+		p->attached_mask |= mask;
+	} else {
+		if (p->attached_mask & mask) {
+			gp->ready = false;
+			gp->snapshot_valid = false;
+			memset(&gp->gamepad, 0, sizeof(gp->gamepad));
+		}
+		p->attached_mask &= ~mask;
+	}
+}
+
+void ogx_transport_init(void)
+{
+	struct ogx_host_ctx *p = &ogx_g_module.present;
+	uint32_t i;
+
+	/* the six XInput stubs reach THIS presentation ctx */
+	ogx_stub_bind_ctx(p);
+
+	/* chain trampolines: native handles pass through these back to the title.
+	 * Declared stdcall (above) so the call site's argument count matches the
+	 * original function's `ret N`; the trampoline body tail-jumps and never
+	 * returns itself. */
+	p->orig_XGetDeviceChanges     = ogx_chain_getdevicechanges;
+	p->orig_XInputOpen            = ogx_chain_inputopen;
+	p->orig_XInputClose           = ogx_chain_inputclose;
+	p->orig_XInputGetCapabilities = ogx_chain_getcaps;
+	p->orig_XInputGetState        = ogx_chain_getstate;
+	p->orig_XInputSetState        = ogx_chain_setstate;
+
+	p->xdevice_type_gamepad = ogx_g_module.host.xdevice_type_gamepad;
+	for (i = 0; i < OGX_MAX_PORTS; i++)
+		p->ports[i] = &ogx_g_module.gport[i];
+
+	gdr_gip_init(&ogx_g_module.gip, 0);
+	gdr_ring_reset(&ogx_g_module.ring);
+
+	/* 24-byte VERIFIED class description */
+	ogx_g_module.desc.MatchByte0 = 0x81;   /* low byte of measured PNP_CLASS_ID 0xFF81 */
+	ogx_g_module.desc.MatchByte1 = 0xFF;   /* high byte                              */
+	ogx_g_module.desc.pad[0] = 0xFF; ogx_g_module.desc.pad[1] = 0xFF;
+	ogx_g_module.desc.Register       = (uint32_t)(uintptr_t)&ogx_gip_register;
+	ogx_g_module.desc.Attach         = (uint32_t)(uintptr_t)&ogx_gip_attach;
+	ogx_g_module.desc.RemoveDevice   = (uint32_t)(uintptr_t)&ogx_gip_remove;
+	ogx_g_module.desc.TypeInfo       = 0;   /* 0xFF device: AddComplete never reads it */
+	ogx_g_module.desc.DispatchTable  = 0;
+
+	/* lifecycle seams persist across re-attach (attach resets per-generation) */
+	ogx_g_module.att.add_complete    = ogx_usb_add_complete;
+	ogx_g_module.att.cancel_request  = ogx_usb_cancel;
+	ogx_g_module.att.remove_complete = ogx_usb_remove_complete;
+}
+
+/* ---- per-title-tick pump (single owner thread) ---------------------------- */
+void ogx_module_pump(void)
+{
+	struct gdr_evt ev;
+
+	while (gdr_ring_pop(&ogx_g_module.ring, &ev)) {
+		if (ev.kind == GDR_EVT_RX) {
+			gdr_gip_rx(&ogx_g_module.gip, ev.data, (int)ev.len);
+		} else if (ev.kind == GDR_EVT_TXDONE && ev.b == GIP_CMD_POWER &&
+		           (long)(int)ev.a >= 0) {
+			gdr_gip_on_power_done(&ogx_g_module.gip);
+		} else if (ev.kind == GDR_EVT_DETACH) {
+			gdr_gip_neutralize(&ogx_g_module.gip);   /* reset snapshot/id/tx/seq */
+		}
+	}
+
+	if (gdr_transport_live((int)ogx_attach_ran, ogx_g_module.att.in_handle)) {
+		if (ogx_g_module.att.state >= 6u && ogx_g_module.gip.gamepad == 0)
+			gdr_gip_qualify_wired(&ogx_g_module.gip);  /* minimal power-on, S-init on done */
+		gdr_gip_poll(&ogx_g_module.gip, 0);
+
+		u8 out_pkt[64]; int out_n;
+		while ((out_n = gdr_tx_drain(&ogx_g_module.gip, out_pkt, 64)) > 0)
+			gdr_tx_enqueue(&ogx_g_module.att, out_pkt, out_n);
+		gdr_tx_submit_next(&ogx_g_module.att);
+	}
+
+	ogx_bridge_publish();
+}
+
+/* ---- status for the parent's readback (bits) ------------------------------ */
+uint32_t ogx_module_status(void)
+{
+	uint32_t s = ogx_g_module.installed_hooks;              /* bits 0..7 (0..6 XInput, 7 FindClass) */
+	if (ogx_g_module.installed_hooks & (1u << 8)) s |= (1u << 8);
+	if (gdr_transport_live((int)ogx_attach_ran, ogx_g_module.att.in_handle)) s |= (1u << 9);
+	if (ogx_g_module.gip.snapshot_valid)     s |= (1u << 10);
+	if (ogx_g_module.install_failed)         s |= (1u << 11);
+	if (ogx_g_module.host.add_complete == 0) s |= (1u << 12);  /* enum not completed (safe) */
+	return s;
+}
+
+_Static_assert(sizeof(struct gdr_snapshot) == 18, "gdr_snapshot 18B");
+_Static_assert(sizeof(struct og_gamepad) == 18, "og_gamepad 18B");
